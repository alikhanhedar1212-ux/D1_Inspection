Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    Splitter Ratio: 0.5
  Tree Height: 549
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Goal Pose1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: CloudRegistered
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Map
    Name: 导航地图（含门口虚拟边界）
    Enabled: true
    Value: true
    Alpha: 1.0
    Color Scheme: map
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/LaserScan
    Name: 实时雷达扫描
    Enabled: true
    Value: true
    Alpha: 1.0
    Color Transformer: FlatColor
    Color: 255; 30; 30
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 3
    Decay Time: 0.3
    Topic:
      Value: /scan
      Depth: 5
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: 机器狗定位候选
    Enabled: true
    Value: true
    Shape: Arrow
    Color: 20; 80; 255
    Alpha: 1.0
    Topic:
      Value: /amcl_pose
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: 6个停留点（待核对）
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /waypoint_candidates
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
  - Class: rviz_default_plugins/Map
    Name: 全局膨胀代价地图
    Enabled: false
    Value: false
    Alpha: 0.5
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
  - Class: rviz_default_plugins/Path
    Name: 规划路径预览
    Enabled: true
    Value: true
    Color: 20; 80; 255
    Line Style: Lines
    Line Width: 0.06
    Topic:
      Value: /preview_path
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /initialpose
  - Class: rviz_default_plugins/PublishPoint
    Topic: /clicked_point
    Single click: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 33.0
      Angle: 0.0
      X: -12.0
      Y: -5.0
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1453
  X: 368
  Y: 104
